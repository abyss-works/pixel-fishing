{
  "name": "pixel-fishing",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:admin": "vite build -c vite.admin.config.ts",
    "build:server": "vite build --ssr api/_server/main.ts --outDir dist-ssr",
    "start": "node dist-ssr/main.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "balance": "tsx tools/balance-report.ts",
    "balance:flow": "tsx tools/balance-flow.ts",
    "load:run": "tsx tools/load/run.ts",
    "mail:send": "tsx tools/mail-send.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.104.1",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "0.31.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
