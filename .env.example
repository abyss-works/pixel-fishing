# 1이면 같은 오리진의 서버(/api, /api/auth)에 붙는 클라우드 빌드다. `.env.local`로 저장
# 비우면 게임은 로컬 저장(오프라인 모드)으로만 동작한다.
VITE_CLOUD=

# 관측 (Sentry) — 없으면 완전 무음. 로컬 dev는 비워 두는 걸 권장(노이즈 방지)
# 클라이언트 DSN은 번들에 박히도록 설계된 공개 값이라 노출돼도 무방하다.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=          # staging | production (비우면 빌드 모드)
# 서버(Express)용 — 서버 환경변수에 설정. 클라와 같은 프로젝트 DSN을 써도 된다
SENTRY_DSN=
SENTRY_ENV=               # 비우면 DEPLOY_ENV 사용, 그것도 없으면 development

# 소유자 메일 (이사 코드 불러오기, 개발 명령, 강제 조우의 스테이징 소유자 판정) — 서버 전용. 비우면 폴백 상수와 비교한다.
# 로그인 계정의 이메일이 없거나 비어 있으면 소유자로 보지 않는다
IMPORT_OWNER_EMAIL=

# 서버 배포 환경 — production | preview | local. 로컬 서버에서 이사 코드 불러오기, 개발 명령, 강제 조우를 쓰려면 local이 필요하다.
# 비우거나 모르는 값이면 이 셋은 거부된다(강제 조우는 통상 캐치로 처리된다). 대소문자와 앞뒤 공백도 구분한다
DEPLOY_ENV=

# 빈 익명 계정 정리 크론(/api/cron/purge-anon) 설정이며 서버 전용이다.
# 비우면 대상을 세어 보고만 하는 dry-run이고, 정확히 1일 때만 실제로 삭제한다.
PURGE_ANON_ENABLED=
