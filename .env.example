# Supabase 프로젝트 값으로 채워서 `.env.local`로 저장 
# 없으면 게임은 로컬 저장(오프라인 모드)으로만 동작한다.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# 관측 (Sentry) — 없으면 완전 무음. 로컬 dev는 비워 두는 걸 권장(노이즈 방지)
# 클라이언트 DSN은 번들에 박히도록 설계된 공개 값이라 노출돼도 무방하다.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=          # staging | production (비우면 빌드 모드)
# 서버(Vercel 함수)용 — Vercel 환경변수에 설정. 클라와 같은 프로젝트 DSN을 써도 된다
SENTRY_DSN=
SENTRY_ENV=               # 비우면 VERCEL_ENV 사용
